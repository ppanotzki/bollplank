{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppanotzki/bollplank/schema/config.schema.json",
  "title": "Bollplank configuration (~/.bollplank/config.json)",
  "description": "Documents the shape for editors. lib/config.mjs validate() is what Bollplank enforces.",
  "type": "object",
  "required": ["approver", "board", "projects"],
  "properties": {
    "approver": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "description": "The person whose explicit words approve a brief and accept a ticket." } } },
    "copyStyle": { "type": "string", "description": "How briefs and comments are written." },
    "board": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "const": "linear" },
        "team": { "type": "string", "description": "The default team for projects that name none." },
        "project": { "type": "string", "description": "The default board project for projects that name none." },
        "statuses": { "$ref": "#/$defs/statuses", "description": "The status names for projects that map none of their own. A name left out is the board kind's suggestion." }
      }
    },
    "critic": {
      "type": "object",
      "properties": {
        "default": { "enum": ["other", "same", "claude", "codex"] },
        "providers": { "$ref": "#/$defs/providerSettings" },
        "same": { "$ref": "#/$defs/providerSettings", "description": "Model and effort for a critic from the same provider as the lead." }
      }
    },
    "shipLock": { "type": "string", "description": "The shipping lock folder. Point it at another kit's lock to share one turn." },
    "projects": { "type": "object", "additionalProperties": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "statuses": {
      "type": "object",
      "properties": { "draft": { "type": "string" }, "ready": { "type": "string" }, "inProgress": { "type": "string" }, "acceptance": { "type": "string" }, "done": { "type": "string" } },
      "additionalProperties": false
    },
    "providerSettings": {
      "type": "object",
      "properties": { "claude": { "$ref": "#/$defs/model" }, "codex": { "$ref": "#/$defs/model" } },
      "additionalProperties": false
    },
    "model": { "type": "object", "properties": { "model": { "type": "string" }, "effort": { "type": "string" } } },
    "repo": {
      "type": "object",
      "required": ["github"],
      "properties": {
        "github": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
        "checks": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "The PR checks that must be green before a merge. Required when the project has runs on." },
        "baseBranch": { "type": "string" },
        "cloneNodeModules": { "type": "boolean" },
        "deploy": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["none", "command", "amplify", "github-actions"] },
            "command": { "type": "string", "description": "For command: run with {commit} replaced, in a clean checkout of the commit." },
            "appId": { "type": "string" },
            "branch": { "type": "string" },
            "region": { "type": "string" },
            "profile": { "type": "string", "description": "For amplify: the AWS profile, when one is needed." },
            "workflow": { "type": "string", "description": "For github-actions: the name, file name or id of the workflow to wait for." }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["source", "tickets"],
      "if": { "properties": { "runs": { "const": true } }, "required": ["runs"] },
      "then": { "properties": { "repos": { "additionalProperties": { "required": ["checks"] } } } },
      "properties": {
        "mode": { "enum": ["repository", "consulting", "configuration"], "default": "repository" },
        "source": { "type": "string" },
        "tickets": { "type": "string" },
        "repos": { "type": "object", "additionalProperties": { "$ref": "#/$defs/repo" } },
        "validatesAgainst": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "shipOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "description": "The order repos merge and deploy in. When given, it lists every configured repo exactly once." },
        "critic": { "type": "object", "properties": { "default": { "enum": ["other", "same", "claude", "codex"], "description": "This project's critic default. It wins over the top level critic.default." } } },
        "board": { "type": "object", "properties": { "team": { "type": "string" }, "project": { "type": "string" }, "teamId": { "type": "string" }, "projectId": { "type": "string" }, "statuses": { "$ref": "#/$defs/statuses", "description": "This project's own status names. A name left out comes from the top level board.statuses." } } },
        "runs": { "type": "boolean", "default": false },
        "privateScan": { "type": "boolean", "default": false },
        "stopList": { "type": "array", "items": { "type": "string" } },
        "ticketPrefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" },
        "allowedTickets": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]+-\\d+$" } },
        "targets": { "type": "object" },
        "runbook": { "type": "string" },
        "verificationChecks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "protectedProjects": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
